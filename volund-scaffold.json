{
  "$schema": "https://os.volund.com.br/schemas/volund-scaffold-1.json",
  "contract": 1,
  "name": "volund-os-scaffold",
  "description": "Next.js (App Router) + Postgres, com node_modules pré-instalado no artefato de release.",
  "stack": {
    "framework": "next",
    "router": "app",
    "language": "typescript",
    "database": "postgres",
    "styling": "tailwind"
  },
  "runtime": {
    "node": ">=20",
    "port": 3000,
    "envRequired": ["DATABASE_URL"]
  },
  "commands": {
    "dev": "npm run dev",
    "build": "npm run build",
    "start": "npm run start",
    "lint": "npm run lint",
    "typecheck": "npm run typecheck",
    "test": "npm run test",
    "format": "npm run format:check"
  },
  "artifact": {
    "kind": "release-asset",
    "asset": "scaffold.zip",
    "includesNodeModules": true,
    "sentinelPackageName": "volund-app",
    "verify": ["package.json", "node_modules/.bin/next"]
  },
  "layout": {
    "migrations": "migrations",
    "components": "components",
    "lib": "lib",
    "types": "types",
    "tests": "tests"
  }
}

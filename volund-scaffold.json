{
  "$schema": "https://os.volund.com.br/schemas/volund-scaffold-1.json",
  "contract": 4,
  "name": "volund-os-scaffold",
  "description": "Next.js (App Router) + Postgres + autentica\u00e7\u00e3o da plataforma (OIDC) + camada de servi\u00e7o com rota de API e endpoint MCP nativos + introspec\u00e7\u00e3o da superf\u00edcie para a governan\u00e7a, com node_modules pr\u00e9-instalado no artefato de release.",
  "stack": {
    "framework": "next",
    "router": "app",
    "language": "typescript",
    "database": "postgres",
    "styling": "tailwind"
  },
  "runtime": {
    "node": ">=20.9.0",
    "port": 3000,
    "envRequired": [
      "DATABASE_URL",
      "VOLUND_OIDC_ISSUER",
      "VOLUND_OIDC_CLIENT_ID",
      "VOLUND_OIDC_CLIENT_SECRET"
    ]
  },
  "commands": {
    "dev": "npm run dev",
    "build": "npm run build",
    "start": "npm run start",
    "lint": "npm run lint",
    "typecheck": "npm run typecheck",
    "test": "npm run test",
    "format": "npm run format:check"
  },
  "artifact": {
    "kind": "release-asset",
    "asset": "scaffold.zip",
    "includesNodeModules": true,
    "sentinelPackageName": "volund-app",
    "verify": ["package.json", "node_modules/.bin/next"]
  },
  "layout": {
    "migrations": "migrations",
    "components": "components",
    "lib": "lib",
    "types": "types",
    "tests": "tests",
    "services": "lib/services",
    "mcp": "lib/mcp",
    "http": "lib/http"
  }
}

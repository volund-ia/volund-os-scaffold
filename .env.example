# Conexão com o Postgres da aplicação.
#
# No VolundOS esta variável é injetada pela plataforma — em desenvolvimento (no
# container do agente) e em produção (no provedor de deploy). Você NÃO precisa
# criá-la à mão, e NUNCA deve versionar o valor real.
#
# Localmente, fora do VolundOS, aponte para um Postgres seu:
DATABASE_URL="postgresql://usuario:senha@localhost:5432/meu_app"

# ----------------------------------------------------------------------------
# Autenticação (OIDC). As três também são injetadas pela plataforma: o App é
# registrado como client no provedor de identidade do VolundOS quando é criado.
#
# Sem elas o App NÃO abre: toda rota fora da vitrine pública responde 503
# dizendo qual variável falta. Isso é deliberado — a alternativa seria um App
# que "funciona" com o sistema aberto para a internet.
# ----------------------------------------------------------------------------

# Provedor de identidade. Entra no claim `iss` de todo token e é comparado por
# igualdade exata: sem barra no fim.
VOLUND_OIDC_ISSUER="https://os.volund.com.br"

# Identificação deste App como client OAuth.
VOLUND_OIDC_CLIENT_ID="cole-o-client-id-aqui"

# EXCLUSIVO DO SERVIDOR. Nunca renomeie para NEXT_PUBLIC_*: o que entra no
# pacote do navegador é público para sempre, e este valor autentica o App
# inteiro no provedor. Ele também deriva a chave que sela o cookie de sessão.
VOLUND_OIDC_CLIENT_SECRET="cole-o-client-secret-aqui"

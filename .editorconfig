# Uma fonte só para o que editor e formatter precisam concordar.
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
# Markdown usa dois espaços no fim da linha como quebra.
trim_trailing_whitespace = false
